{
  // Isolated non-production Worker for BOOKED AF checkout/access testing.
  // Do not add production secrets or production KV bindings here.
  "name": "booked-af-email-test",
  "main": "test-worker.mjs",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "keep_vars": true,
  "build": {"command": "node scripts/build-test-worker.mjs"},
  "assets": {"directory": "./.test-website", "binding": "ASSETS", "run_worker_first": true},
  "routes": [],
  "durable_objects": {"bindings":[{"name":"FULFILLMENT","class_name":"TestPurchaseFulfillment"},{"name":"TEST_LIFECYCLE","class_name":"TestLifecycle"}]},
  "migrations": [{"tag":"test-fulfillment-v1","new_sqlite_classes":["TestPurchaseFulfillment"]},{"tag":"test-lifecycle-v1","new_sqlite_classes":["TestLifecycle"]}],
  "vars": {"BOOKED_AF_TEST_MARKER": "booked-af-isolated-test"},
  "previews": {}
}
